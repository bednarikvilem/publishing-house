                        "author": "Sebastian Schuster"
                      },
                      "clip": true,
                      "width": "fill_container",
                      "height": 360,
                      "fill": {
                        "type": "image",
                        "enabled": true,
                        "url": "https://images.unsplash.com/photo-1756776486544-5c1e2c12b25c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3NzQzNzMwNDN8&ixlib=rb-4.1.0&q=80&w=1080",
                        "mode": "fill"
                      },
