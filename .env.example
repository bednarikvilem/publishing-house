# Copy this file to .env and fill in the values
# Never commit .env to git

POSTGRES_USER=newspaper
POSTGRES_PASSWORD=newspaper
POSTGRES_DB=newspaper_db
JWT_SECRET=newspaper

DATABASE_URL=postgres://newspaper:newspaper@localhost:5432/newspaper_db

# SMTP — Mailtrap sandbox (copy credentials from mailtrap.io → Inboxes → SMTP Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@example.com

# Base URL of the frontend (used to build links in emails)
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (new image storage destination)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=pb138-images
PUBLIC_IMAGES_BASE_URL=http://localhost:9000

# Credentials for e2e tests

TEST_BASE_URL=http://localhost:5173
TEST_NEWSPAPER=munijournal
TEST_EMAIL=emma.bednarikova@email.cz
TEST_PASSWORD=test1234

