{
  "name": "@pb138/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/server.ts",
    "./db/validators": "./src/db/validators.ts",
    "./db/schema": "./src/db/schema.ts"
  },
  "scripts": {
    "dev": "bun run --watch --env-file=../../.env src/server.ts",
    "build": "bun build src/server.ts --outdir dist",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:bootstrap": "bun --env-file=../../.env scripts/bootstrap-migrations.ts",
    "db:seed": "bun --env-file=../../.env src/db/seed.ts",
    "test": "bun --env-file=../../.env test"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/openapi": "^1.4.15",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.28",
    "nodemailer": "^8.0.5",
    "postgres": "^3.4.9",
    "sharp": "^0.34.0"
  }
}
